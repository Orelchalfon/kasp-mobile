# Copy to .env and fill in. All EXPO_PUBLIC_* values ship inside the app bundle (public).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
EXPO_PUBLIC_WEB_ORIGIN=https://kasp-web.kasp.workers.dev

# Integration tests only (pnpm test:integration) - put these in .env.test, never EXPO_PUBLIC_*.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
