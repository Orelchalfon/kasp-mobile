{
  "name": "kasp-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "start:dev": "expo start --dev-client",
    "build:android:dev": "expo run:android"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "~13.0.0",
    "@elevenlabs/react-native": "1.2.30",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "~2.12.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "~144.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "expo": "~54.0.36",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "livekit-client": "^2.23.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "lightningcss": "1.30.1",
    "postcss": "8.5.29",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.ts?(x)"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup-unit.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        }
      },
      {
        "displayName": "integration",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.ts"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup-integration.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        }
      }
    ]
  }
}
